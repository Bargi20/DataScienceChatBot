version: "3.1"

# Area catalogo: domande sui prodotti del negozio.
#
# Valori canonici dell'entità `categoria` (gli stessi della colonna `categorie` di dataset/catalogo.csv):
#   strategia, famiglia, party, cooperativo, carte, bambini, astratto, deckbuilding, legacy,
#   solitario, per due, investigativo, piazzamento lavoratori, roll and write, avventura,
#   bluff, dadi, accessori
# I sinonimi in fondo al file riportano a questi valori i modi più comuni di chiamarli;
# actions/catalogo.py (categoria_canonica) fa la stessa cosa nel codice.
#
# I nomi dei giochi da riconoscere come entità `gioco` sono nella lookup table
# data/catalogo/lookup_giochi.yml, generata da dataset/genera_lookup.py.

nlu:
- intent: info_gioco
  examples: |
    - parlami di [Catan](gioco)
    - cos'è [Wingspan](gioco)?
    - di cosa parla [Terraforming Mars](gioco)?
    - mi descrivi [dixit](gioco)?
    - com'e [azul](gioco)? non lo conosco
    - vorrei sapere qualcosa su [Root](gioco)
    - info su [7 wonders duel](gioco)
    - dimmi tutto su [Spirit Island](gioco)
    - che tipo di gioco e [Dune Imperium](gioco)?
    - come funziona [codenames](gioco)?
    - mi dai qualche informazione su [carcasone](gioco)
    - scheda di [Everdell](gioco)
    - cosa mi sai dire di [lorenzo il magnifico](gioco)?
    - raccontami qualcosa di [Gloomhaven](gioco)
    - in cosa consiste [Sky Team](gioco)?
    - descrizione di [ticket to ride](gioco)
    - che cos'e [Mysterium](gioco)
    - voglio saperne di piu su [kingdomino](gioco)
    - dettagli su [Arkham Horror](gioco) per favore
    - ho sentito parlare di [Brass Birmingham](gioco), di che si tratta?
    - mi spieghi in due parole [Harmonies](gioco)?
    - [Cartographers](gioco) che gioco è?
    - parlami di questo gioco
    - dimmi di piu su quel gioco
    - com'è fatto questo gioco?

- intent: chiedi_prezzo
